# Copy this file to ".env" for local development, and add the same values as
# "Repository variables" (Settings > Secrets and variables > Actions > Variables)
# if you want the deployed site to use them too. Never commit your real ".env" file.

# The full public URL the site will be deployed to, including the repository path
# and a trailing slash. Used only for canonical/Open Graph tags in index.html. Must
# keep the VITE_ prefix -- that's what makes Vite substitute %VITE_SITE_URL% in
# index.html at build time.
# Example: https://your-username.github.io/your-repo-name/
VITE_SITE_URL=https://your-username.github.io/your-repo-name/
